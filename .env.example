# Keep real credentials in .env and never commit them to Git.
TUSHARE_TOKEN=your_tushare_token_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZAI_API_KEY=your_zai_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=your_model_api_key_here
LLM_API_SECRET=
RESEARCH_SANDBOX_URL=your_private_research_sandbox_url
# Optional overrides for the GLM chat-research runtime (切换模型 glm).
# Defaults: the Zhipu Coding Plan endpoint and glm-5.3.
GLM_AGENT_BASE_URL=
GLM_AGENT_MODEL=
PUBLIC_APP_URL=https://your-public-service.example
TUSHARE_CACHE_BUCKET=your_private_cache_bucket_here
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token
FEISHU_ENCRYPT_KEY=your_feishu_encrypt_key
FEISHU_ALLOWED_OPEN_IDS=
MASSIVE_API_KEY=your_massive_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
