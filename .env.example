# Keep real credentials in .env and never commit them to Git.
TUSHARE_TOKEN=your_tushare_token_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZAI_API_KEY=your_zai_api_key_here
# Planning-provider switch: deepseek (default) or glm. With glm, ZAI_API_KEY
# drives the query planner, Feishu agent, and UI feedback assistant, and
# DEEPSEEK_API_KEY becomes optional.
LLM_PROVIDER=deepseek
# GLM endpoint override. The default below is the GLM Coding Plan endpoint,
# which consumes the subscription's included quota (5-hour and weekly caps,
# shared with your coding tools). To bill pay-as-you-go account balance
# instead, use https://open.bigmodel.cn/api/paas/v4/chat/completions.
GLM_API_URL=
# Optional GLM model overrides (defaults: glm-5.3-flash and glm-5.3).
GLM_MODEL=
GLM_FALLBACK_MODEL=
TUSHARE_CACHE_BUCKET=your_private_cache_bucket_here
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token
FEISHU_ENCRYPT_KEY=your_feishu_encrypt_key
FEISHU_ALLOWED_OPEN_IDS=
MASSIVE_API_KEY=your_massive_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
